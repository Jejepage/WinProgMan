{
  "name": "winprogman",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests package.json tsconfig.json vite.config.ts playwright.config.ts index.html .github/workflows/ci.yml",
    "format:check": "prettier --check src tests package.json tsconfig.json vite.config.ts playwright.config.ts index.html .github/workflows/ci.yml"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "lucide-react": "^1.56.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^5.1.0",
    "fake-indexeddb": "^6.2.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^5.0.4"
  }
}
